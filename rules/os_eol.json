{
  "_comment": "Fin de soporte estándar del fabricante por sistema operativo. Cada entrada se busca por 'pattern' (expresión regular) o, si no tiene, por 'match' (subcadena), en orden y sin distinguir mayúsculas, sobre el prettyName de Guest Detailed Data, el SO de VMware Tools y el del archivo de configuración, en ese orden. status to_verify: fecha cargada de memoria, falta confirmar contra la página de ciclo de vida del fabricante.",
  "rules_version": "2026-11-04",
  "entries": [
    {"match": "windows server 2003", "label": "Windows Server 2003", "end_of_support": "2015-07-14", "status": "to_verify", "source": "https://learn.microsoft.com/lifecycle/products/windows-server-2003-"},
    {"match": "windows server 2008", "label": "Windows Server 2008 / 2008 R2", "end_of_support": "2020-01-14", "status": "to_verify", "source": "https://learn.microsoft.com/lifecycle/products/windows-server-2008-r2"},
    {"match": "windows server 2012", "label": "Windows Server 2012 / 2012 R2", "end_of_support": "2023-10-10", "status": "to_verify", "source": "https://learn.microsoft.com/lifecycle/products/windows-server-2012-r2"},
    {"match": "windows server 2016", "label": "Windows Server 2016", "end_of_support": "2027-01-12", "status": "to_verify", "source": "https://learn.microsoft.com/lifecycle/products/windows-server-2016", "pattern": "windows server 2016(?! or later)"},
    {"match": "centos 6", "label": "CentOS 6", "end_of_support": "2020-11-30", "status": "to_verify", "source": "https://www.centos.org/centos-linux-eol/", "pattern": "centos( linux)? 6\\b"},
    {"match": "centos 7", "label": "CentOS 7", "end_of_support": "2024-06-30", "status": "to_verify", "source": "https://www.centos.org/centos-linux-eol/", "pattern": "centos( linux)? 7\\b"},
    {"match": "centos 8", "label": "CentOS 8", "end_of_support": "2021-12-31", "status": "to_verify", "source": "https://www.centos.org/centos-linux-eol/", "pattern": "centos( linux)? 8\\b"},
    {"match": "red hat enterprise linux 6", "label": "RHEL 6", "end_of_support": "2020-11-30", "status": "to_verify", "source": "https://access.redhat.com/support/policy/updates/errata", "pattern": "red hat enterprise linux( server)? 6\\b"},
    {"match": "red hat enterprise linux 7", "label": "RHEL 7", "end_of_support": "2024-06-30", "status": "to_verify", "source": "https://access.redhat.com/support/policy/updates/errata", "pattern": "red hat enterprise linux( server)? 7\\b"},
    {"match": "ubuntu linux (64-bit) 16", "label": "Ubuntu 16.04", "end_of_support": "2021-04-30", "status": "to_verify", "source": "https://ubuntu.com/about/release-cycle"},
    {"match": "ubuntu 16.04", "label": "Ubuntu 16.04", "end_of_support": "2021-04-30", "status": "to_verify", "source": "https://ubuntu.com/about/release-cycle"},
    {"match": "ubuntu 18.04", "label": "Ubuntu 18.04", "end_of_support": "2023-05-31", "status": "to_verify", "source": "https://ubuntu.com/about/release-cycle"},
    {"match": "ubuntu 20.04", "label": "Ubuntu 20.04", "end_of_support": "2025-05-31", "status": "to_verify", "source": "https://ubuntu.com/about/release-cycle"},
    {"match": "suse linux enterprise 12", "label": "SLES 12", "end_of_support": "2024-10-31", "status": "to_verify", "source": "https://www.suse.com/lifecycle/", "pattern": "suse linux enterprise( server)? 12\\b"},
    {"match": "debian gnu/linux 9", "label": "Debian 9", "end_of_support": "2022-06-30", "status": "to_verify", "source": "https://wiki.debian.org/LTS", "pattern": "debian gnu/linux 9\\b"},
    {"match": "debian gnu/linux 10", "label": "Debian 10", "end_of_support": "2024-06-30", "status": "to_verify", "source": "https://wiki.debian.org/LTS", "pattern": "debian gnu/linux 10\\b"},
    {"match": "windows xp", "label": "Windows XP", "end_of_support": "2014-04-08", "status": "to_verify", "source": "https://learn.microsoft.com/lifecycle/products/windows-xp"},
    {"match": "windows 7", "pattern": "windows 7\\b", "label": "Windows 7", "end_of_support": "2020-01-14", "status": "to_verify", "source": "https://learn.microsoft.com/lifecycle/products/windows-7"},
    {"match": "windows 8", "pattern": "windows 8(\\.1)?\\b", "label": "Windows 8.1", "end_of_support": "2023-01-10", "status": "to_verify", "source": "https://learn.microsoft.com/lifecycle/products/windows-81"},
    {"match": "windows 10", "pattern": "windows 10\\b", "label": "Windows 10", "end_of_support": "2025-10-14", "status": "to_verify", "note": "Ediciones Home, Pro y Enterprise 22H2. Hay ESU pagado y las ediciones LTSC tienen otras fechas.", "source": "https://learn.microsoft.com/lifecycle/products/windows-10-enterprise-and-education"},
    {"match": "suse linux enterprise 11", "pattern": "suse linux enterprise( server)? 11\\b", "label": "SLES 11", "end_of_support": "2019-03-31", "status": "to_verify", "source": "https://www.suse.com/lifecycle/"}
  ],
  "ambiguous": {"patterns": ["or later", "^ubuntu linux \\(", "^rocky linux \\(", "^other .*linux"], "note": "Nombres de SO que no dicen la versión (genéricos de vSphere). Se cuentan aparte: hay que ver la versión en Guest Detailed Data o en la VM."}
}
